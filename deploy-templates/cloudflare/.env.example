# Cloudflare credentials (deploy-time)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token-with-workers-edit-and-kv-write

# AM connection (runtime — alchemy.run.ts reads these from process.env at
# deploy time and binds them to the Worker's env. Plain values become
# `secret_text` bindings; COOKIE_SECRET is wrapped with `Redacted` in the
# template so it never logs in plaintext during the deploy.)
FR_AM_URL=https://your-am-instance.example.com/am
FR_AM_COOKIE_NAME=iPlanetDirectoryPro
FR_OAUTH_PUBLIC_CLIENT=WebLoginWidgetClient
FR_REALM_PATH=alpha
# FR_OAUTH_SCOPE=openid profile me.read   # optional

# Session cookie signing
COOKIE_SECRET=change-me-to-a-random-string-of-at-least-32-characters
