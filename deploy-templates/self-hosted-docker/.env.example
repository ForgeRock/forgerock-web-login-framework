# AM connection (runtime — read by $env/dynamic/private)
FR_AM_URL=https://your-am-instance.example.com/am
FR_AM_COOKIE_NAME=iPlanetDirectoryPro
FR_OAUTH_PUBLIC_CLIENT=WebLoginWidgetClient
FR_REALM_PATH=alpha
# FR_OAUTH_SCOPE=openid profile me.read   # optional — AM uses client defaults if omitted

# Public origin the browser uses to reach the login app. Must match scheme + host +
# port shown in the URL bar. SvelteKit's CSRF protection rejects POSTs whose
# Origin header doesn't match this value.
#   Local dev:    http://localhost:3000
#   Behind a TLS-terminating proxy:  https://login.example.com
ORIGIN=http://localhost:3000

# Session cookie signing (HMAC over the browser-facing session UUID)
COOKIE_SECRET=change-me-to-a-random-string-of-at-least-32-characters
