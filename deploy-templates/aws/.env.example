# AWS credentials (deploy-time) — or use AWS_PROFILE / SSO / IAM role
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# ECR registry for the Lambda container image
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY=login-app

# AM connection (runtime — set as Lambda env or via Secrets Manager)
FR_AM_URL=https://your-am-instance.example.com/am
FR_AM_COOKIE_NAME=iPlanetDirectoryPro
FR_OAUTH_PUBLIC_CLIENT=WebLoginWidgetClient
FR_REALM_PATH=alpha
# FR_OAUTH_SCOPE=openid profile me.read   # optional

# Session cookie signing
COOKIE_SECRET=change-me-to-a-random-string-of-at-least-32-characters
