# ForgeRock AM connection (runtime — passed as env vars to the container).
#
# IMPORTANT: this file is consumed by `docker run --env-file`, which does
# NOT strip quotes and does NOT support inline comments after a value.
#   ✅ FR_AM_URL=https://example.com/am
#   ❌ FR_AM_URL='https://example.com/am'   (quotes become part of the value)
#   ❌ FR_REALM_PATH=alpha   # this is bad   (trailing text becomes part of the value)
#
FR_AM_URL=https://your-am-instance.example.com/am
FR_AM_COOKIE_NAME=iPlanetDirectoryPro
FR_OAUTH_PUBLIC_CLIENT=WebLoginWidgetClient
FR_REALM_PATH=alpha
# FR_OAUTH_SCOPE=openid profile me.read  # optional — AM uses client defaults if omitted

# BFF session signing (required for cookie HMAC)
COOKIE_SECRET=<<<(string) At least 32 characters for HMAC signing>>>
