# ForgeRock AM connection (runtime — passed as env vars to the container)
FR_AM_URL=https://your-am-instance.example.com/am
FR_AM_COOKIE_NAME=iPlanetDirectoryPro
FR_AM_WELLKNOWN_URL=https://your-am-instance.example.com/am/oauth2/realms/root/realms/alpha/.well-known/openid-configuration
FR_REALM_PATH=alpha
# FR_AM_JOURNEY_LOGIN=Login  # optional — default login journey name; used for IDM theme resolution when no ?journey= param is present
