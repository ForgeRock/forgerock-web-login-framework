{
  "name": "@forgerock/login-widget-generator",
  "version": "0.1.0",
  "description": "CLI generator for ForgeRock Login Widget custom component projects",
  "type": "module",
  "bin": {
    "ping-law": "./dist/main.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc && ([ -d templates ] && cp -r templates/ dist/templates/ || true)",
    "dev": "tsc --watch",
    "test": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": ["forgerock", "ping-identity", "login", "widget", "generator", "svelte"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ForgeRock/forgerock-web-login-framework.git",
    "directory": "tools/cli"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "effect": "^3.21.0",
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.106.0",
    "@effect/printer": "^0.49.0",
    "@effect/printer-ansi": "^0.49.0",
    "@effect/typeclass": "^0.40.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vitest": "^3.0.0"
  }
}
