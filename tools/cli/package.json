{
  "name": "@forgerock/login-framework-cli",
  "version": "0.1.0",
  "description": "CLI tool for scaffolding and managing Ping Login Widget and Login App custom component projects",
  "type": "module",
  "exports": {
    ".": "./dist/src/main.js"
  },
  "main": "./dist/src/main.js",
  "module": "./dist/src/main.js",
  "bin": {
    "ping-lf": "./dist/src/main.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/src/main.js && ([ -d templates ] && cp -r templates/ dist/src/templates/ || true)",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": ["ping-identity", "forgerock", "login", "widget", "cli", "generator", "svelte"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ForgeRock/forgerock-web-login-framework.git",
    "directory": "tools/cli"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.106.0",
    "@effect/printer": "^0.49.0",
    "@effect/printer-ansi": "^0.49.0",
    "@effect/typeclass": "^0.40.0",
    "effect": "^3.21.0",
    "svelte": "^5.55.7",
    "tar": "^7.5.13"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vitest": "^3.0.0"
  }
}
