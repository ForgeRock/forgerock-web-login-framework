{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "$core": ["../../core"],
      "$core/*": ["../../core/*"],
      "$components": ["../../core/components"],
      "$components/*": ["../../core/components/*"],
      "$journey": ["../../core/journey"],
      "$journey/*": ["../../core/journey/*"],
      "$app-locales": ["./src/locales"],
      "$app-locales/*": ["./src/locales/*"],
      "$locales": ["../../core/locales"],
      "$locales/*": ["../../core/locales/*"],
      "$package": ["../../packages/login-widget/dist"],
      "$package/*": ["../../packages/login-widget/dist/*"],
      "$server": ["./src/lib/server"],
      "$server/*": ["./src/lib/server/*"],
      "$login-framework": ["../../custom/components/login-framework.ts"],
      "$custom": ["../../custom/components"],
      "$custom/*": ["../../custom/components/*"],
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    },
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["../../core/locales/**", "src/routes/e2e/**"]
}
