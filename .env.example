# ForgeRock AM connection (runtime — read by $env/dynamic/private)
FR_AM_URL=<<<(string) URL to your AM instance>>>
FR_AM_COOKIE_NAME=<<<(string) The name of the ForgeRock server cookie>>>
FR_REALM_PATH=<<<(string) Realm path of AM>>>
FR_AM_WELLKNOWN_URL=<<<(string) Your OIDC Discovery Wellknown Endpoint>>>
# FR_AM_JOURNEY_LOGIN=Login  # optional — default login journey name; used for IDM theme resolution when no ?journey= param is present, and as the restart fallback for bare suspendedId links with no journey identity


# Testing (CI only)
FR_AM_ADMIN_USERNAME=<<<(string) your AM admin username>>>
FR_AM_ADMIN_PASSWORD=<<<(string) your AM admin password>>>
FR_AM_CREATE_USER_URL=<<<(string) URL to your AM instance create new user end point>>>
FR_AM_DELETE_USER_URL=<<<(string) URL to your AM instance delete new user end point>>>

# Custom Components API (disabled unless opted in; intended for dev tenants only)
# COMPONENT_API_ENABLED=true  # required to serve /api/components/* at all
# ORIGIN=http://localhost:3000  # this app's origin — REQUIRED whenever COMPONENT_API_ENABLED
# is on: cookie-carried admin mutations (POST/PUT/DELETE) are rejected with 500 until it is set
# CONFIG_REPO_DIR=/config       # config repo root for the compose config profile (default /config)
# CONFIG_TRACKED_SUBPATH=config # tracked subtree config-saver commits (default config)
# Callers authenticate with an AM admin session: the browser session cookie or
# `Authorization: Bearer <AM session token>` for CLI clients.
