.DS_Store
storybook-static
node_modules
/build
apps/login-app/build/

# SvelteKit generated
.svelte-kit

# Widget build output
packages/login-widget/dist/
packages/login-widget/svelte-package/

# CLI build output
tools/cli/dist/

# Environment
.env
.env.*
!.env.example

# Test results
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Lockfiles (pnpm only — prevent accidental npm/yarn lockfiles)
package-lock.json
yarn.lock

# Generated type declarations (core/ has no compiled JS — TS reads .ts source directly)
core/**/*.d.ts

# Auto-generated custom component registry (produced by the login-framework Vite plugin)
core/journey/_utilities/registry/custom-registry.ts

# Custom component implementations (developer-authored; gitignored so customer forks don't conflict)
# The stage/, callback/, header/ and footer/ folders themselves (with .gitkeep) remain tracked as scaffolding references.
# The demo-header/demo-footer components are negated back INTO tracking: they are the
# Enabled: true reference components the e2e render test asserts against. Other
# developer-authored header/footer dirs stay ignored.
experimental/custom/stages/*/
experimental/custom/callbacks/*/
experimental/custom/headers/*/
!experimental/custom/headers/demo-header/
experimental/custom/footers/*/
!experimental/custom/footers/demo-footer/

# Claude Code
.claude/
.mcp.json

# Misc
.syncthing*
.eslintcache
tools/cli/tmp/
packages/login-widget/tmp/
.playwright-mcp/

.polaris/
